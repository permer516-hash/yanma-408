# 研码408 production template

# Frontend
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api
E2E_BASE_URL=https://app.example.com

# Backend
SERVER_PORT=18082
SPRING_PROFILES_ACTIVE=prod
YANMA408_DB_URL=jdbc:postgresql://postgres.example.com:5432/yanma408
YANMA408_DB_USERNAME=yanma408_app
YANMA408_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# PostgreSQL backup/maintenance scripts
POSTGRES_DB=yanma408
POSTGRES_USER=yanma408_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
BACKUP_DIR=./backups

# Redis or future async/cache integrations
REDIS_HOST=redis.example.com
REDIS_PORT=6379

# Release checks
DEMO_ACCOUNT_ACTION=locked
