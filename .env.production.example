# 研码408 production template

# Frontend
# The production reverse proxy exposes the API on the same domain under /api.
NEXT_PUBLIC_API_BASE_URL=/api
E2E_BASE_URL=https://example.com

# Backend
SERVER_PORT=18082
SPRING_PROFILES_ACTIVE=prod
YANMA408_DB_URL=jdbc:postgresql://postgres:5432/yanma408
YANMA408_DB_USERNAME=yanma408_app
YANMA408_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# PostgreSQL backup/maintenance scripts
POSTGRES_DB=yanma408
POSTGRES_USER=yanma408_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
BACKUP_DIR=./backups

# Tencent COS / S3-compatible object storage
YANMA408_OBJECT_STORAGE_ENDPOINT=https://your-bucket-1250000000.cos.ap-guangzhou.myqcloud.com
YANMA408_OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_COS_SECRET_ID
YANMA408_OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_COS_SECRET_KEY
YANMA408_OBJECT_STORAGE_BUCKET=your-bucket-1250000000
YANMA408_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://your-bucket-1250000000.cos.ap-guangzhou.myqcloud.com

# Release checks
DEMO_ACCOUNT_ACTION=locked
