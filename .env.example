# 研码408 local development

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:18082/api
E2E_BASE_URL=http://localhost:3000
PLAYWRIGHT_CHANNEL=chrome

# Backend
SERVER_PORT=18082
SPRING_PROFILES_ACTIVE=local-h2

# PostgreSQL profile values used by deploy/docker-compose.yml
POSTGRES_DB=yanma408
