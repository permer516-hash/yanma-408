POSTGRES_PASSWORD=yanma408
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/yanma408
SPRING_DATASOURCE_USERNAME=yanma408
SPRING_DATASOURCE_PASSWORD=yanma408
YANMA408_DB_URL=jdbc:postgresql://localhost:5432/yanma408
YANMA408_DB_USERNAME=yanma408
YANMA408_DB_PASSWORD=yanma408
BACKUP_DIR=./backups

# Redis is reserved for later cache/async work.
REDIS_HOST=localhost
REDIS_PORT=6380
